PORT=5000
HOST=localhost
SERVER_URL=http://localhost:5000
MONGO_URI=mongodb://127.0.0.1:27017/notesapp
# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/notesapp?retryWrites=true&w=majority
JWT_SECRET=your_96_character_hex_secret_here_generate_with_crypto_randomBytes_48
NODE_ENV=development

# Route Endpoints
HEALTH_ENDPOINT=/api/health
AUTH_ENDPOINT=/api/auth
NOTES_ENDPOINT=/api/notes

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173
