# Backend API Target URL for Vite Proxy & Dev Server
# Set to local backend (http://localhost:5000) or remote (e.g. https://notepad1-ig4f.onrender.com)
VITE_API_URL=http://localhost:5000
# VITE_API_URL=https://notepad1-ig4f.onrender.com

# Backend API Endpoints
VITE_AUTH_ENDPOINT=/api/auth
VITE_NOTES_ENDPOINT=/api/notes
VITE_HEALTH_ENDPOINT=/api/health

# Environment
NODE_ENV=development
